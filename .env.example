# ==========================================
# TeraWet Sales Agent Configuration
# ==========================================

# 1. AI Model API Key (OpenAI or Google Gemini)
# Leave empty to use built-in offline template generator
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Or Gemini:
# GEMINI_API_KEY=your-gemini-api-key
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash

# 2. Data Source ('csv' or 'google_sheets')
DATA_SOURCE=csv
CSV_FILE_PATH=leads_sample.csv

# If using Google Sheets:
# GOOGLE_SHEET_ID=your_google_sheet_id_here
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# 3. Gmail Integration (Drafts creation)
# Set to 'true' once credentials.json is downloaded from Google Cloud Console
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle
LOCAL_DRAFTS_DIR=drafts_preview

# 4. Sender Information (appears in email signature)
SENDER_NAME=Екип Продажби TERAWET
SENDER_COMPANY=ВАНКО 97 ЕООД / TERAWET®
SENDER_PHONE=+359 888 516501
SENDER_WEBSITE=https://terawet.eu
